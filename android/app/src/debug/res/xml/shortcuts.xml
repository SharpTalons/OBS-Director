<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="clip"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_clip"
        android:shortcutShortLabel="@string/shortcut_clip"
        android:shortcutLongLabel="@string/shortcut_clip_long">
